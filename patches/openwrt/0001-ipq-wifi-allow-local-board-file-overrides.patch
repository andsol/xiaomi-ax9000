From 4d8638b02abb985d899a839558ad2946cbb365cd Mon Sep 17 00:00:00 2001
From: Andrey <ax9000@users.noreply.invalid>
Date: Sun, 22 Nov 2026 10:32:23 +0000
Subject: [PATCH 1/2] ipq-wifi: allow local board file overrides

Copy any board-* files found in the package's local src/ directory over
the unpacked qca-wireless sources, so a device-specific board data file
can be supplied without touching the upstream source tarball. Nothing
happens when src/ has no board files, so other boards are unaffected.

Signed-off-by: Andrey <ax9000@users.noreply.invalid>
---
 package/firmware/ipq-wifi/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index d3605dd622..203a158b3e 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -13,6 +13,11 @@ PKG_FLAGS:=nonshared
 
 include $(INCLUDE_DIR)/package.mk
 
+define Build/Prepare
+	$(call Build/Prepare/Default)
+	$(if $(wildcard ./src/board-*),$(CP) ./src/board-* $(PKG_BUILD_DIR)/)
+endef
+
 define Build/Compile
 endef
 
-- 
2.39.5

