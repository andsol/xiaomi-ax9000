From c07adbf0b2cdbdc3eeb2fb281813170bbf4c6c37 Mon Sep 17 00:00:00 2001
From: Andrey <ax9000@users.noreply.invalid>
Date: Sun, 22 Nov 2026 11:14:59 +0000
Subject: [PATCH 201/202] qualcommax: ipq807x: add IPQ8074 (v1) PWM support

IPQ8074 has the older Qualcomm PWM block inside the ADSS (audio
subsystem) at 0x07700000, not the IPQ6018 (v2) block in TCSR that
pwm-ipq drives. Qualcomm's SDK handles it with the "ops_v1" of
pwm-ipq4019.c / pwm-ipq.c: one control register per channel
(ADSS_GLB_PWMn_CTRL, ADSS + 0x20 + 4 * n) with ENABLE/UPDATE bits, an
8-bit pre-divider, an 11-bit high duration and a 10-bit divider.

Kernel patches:
- 0307: dt-binding: add the qcom,ipq8074-pwm compatible
- 0308: pwm-ipq: add the v1 register layout, selected by that compatible
- 0309: ipq8074.dtsi: add the (disabled) PWM node, reg 0x07700020/0x10,
  GCC_ADSS_PWM_CLK at 200 MHz like the SDK

Enable PWM, PWM_IPQ, LEDS_CLASS_MULTICOLOR and LEDS_PWM_MULTICOLOR for
ipq807x. (In 6.12 the PWM sysfs interface is built into the PWM core;
there is no PWM_SYSFS symbol any more.) LEDS_QCOM_LPG (PMIC LED
driver) becomes visible with PWM=y; it is not used here, so mark it "not
set" to keep the kernel config complete.

Signed-off-by: Andrey <ax9000@users.noreply.invalid>
---
 .../linux/qualcommax/ipq807x/config-default   |   5 +
 ...m-ipq6018-pwm-add-IPQ8074-compatible.patch |  55 ++++
 ...support-for-the-IPQ8074-v1-PWM-block.patch | 265 ++++++++++++++++++
 ...-arm64-dts-qcom-ipq8074-add-PWM-node.patch |  31 ++
 4 files changed, 356 insertions(+)
 create mode 100755 target/linux/qualcommax/patches-6.12/0307-dt-bindings-pwm-qcom-ipq6018-pwm-add-IPQ8074-compatible.patch
 create mode 100755 target/linux/qualcommax/patches-6.12/0308-pwm-ipq-add-support-for-the-IPQ8074-v1-PWM-block.patch
 create mode 100755 target/linux/qualcommax/patches-6.12/0309-arm64-dts-qcom-ipq8074-add-PWM-node.patch

diff --git a/target/linux/qualcommax/ipq807x/config-default b/target/linux/qualcommax/ipq807x/config-default
index 1fa8d84ad6..a667f85b46 100644
--- a/target/linux/qualcommax/ipq807x/config-default
+++ b/target/linux/qualcommax/ipq807x/config-default
@@ -2,6 +2,9 @@ CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
 CONFIG_DT_IDLE_GENPD=y
 CONFIG_GRO_CELLS=y
 CONFIG_IPQ_GCC_8074=y
+CONFIG_LEDS_CLASS_MULTICOLOR=y
+CONFIG_LEDS_PWM_MULTICOLOR=y
+# CONFIG_LEDS_QCOM_LPG is not set
 CONFIG_MDIO_BITBANG=y
 CONFIG_MDIO_GPIO=y
 # CONFIG_MFD_HI6421_SPMI is not set
@@ -18,6 +21,8 @@ CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
 CONFIG_PM_GENERIC_DOMAINS=y
 CONFIG_PM_GENERIC_DOMAINS_OF=y
 # CONFIG_POWER_RESET_QCOM_PON is not set
+CONFIG_PWM=y
+CONFIG_PWM_IPQ=y
 CONFIG_QCA83XX_PHY=y
 CONFIG_QCOM_APM=y
 # CONFIG_QCOM_COINCELL is not set
diff --git a/target/linux/qualcommax/patches-6.12/0307-dt-bindings-pwm-qcom-ipq6018-pwm-add-IPQ8074-compatible.patch b/target/linux/qualcommax/patches-6.12/0307-dt-bindings-pwm-qcom-ipq6018-pwm-add-IPQ8074-compatible.patch
new file mode 100755
index 0000000000..841712e0cb
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0307-dt-bindings-pwm-qcom-ipq6018-pwm-add-IPQ8074-compatible.patch
@@ -0,0 +1,55 @@
+From: Andrey <ax9000@users.noreply.invalid>
+Subject: [PATCH] dt-bindings: pwm: qcom,ipq6018-pwm: add IPQ8074 compatible
+
+IPQ8074 has the older (v1) Qualcomm PWM block: four channels in the
+ADSS (audio subsystem) block, one control register per channel
+(ADSS_GLB_PWMn_CTRL at ADSS + 0x20 + 4 * n) with an 8-bit pre-divider,
+a 10-bit divider and an 11-bit high duration. Add the
+qcom,ipq8074-pwm compatible for it.
+
+Signed-off-by: Andrey <ax9000@users.noreply.invalid>
+---
+--- a/Documentation/devicetree/bindings/pwm/qcom,ipq6018-pwm.yaml
++++ b/Documentation/devicetree/bindings/pwm/qcom,ipq6018-pwm.yaml
+@@ -11,13 +11,21 @@
+ 
+ properties:
+   compatible:
+-    items:
+-      - enum:
+-          - qcom,ipq5018-pwm
++    oneOf:
++      - items:
++          - enum:
++              - qcom,ipq5018-pwm
++          - const: qcom,ipq6018-pwm
+       - const: qcom,ipq6018-pwm
++      - description:
++          Older (v1) PWM block with one control register per channel
++          (8-bit pre-divider, 10-bit divider, 11-bit high duration)
++        const: qcom,ipq8074-pwm
+ 
+   reg:
+-    description: Offset of PWM register in the TCSR block.
++    description:
++      Offset of PWM register in the TCSR block. For qcom,ipq8074-pwm, the
++      four channel control registers (ADSS_GLB_PWMn_CTRL) in the ADSS block.
+     maxItems: 1
+ 
+   clocks:
+@@ -46,3 +54,15 @@
+         assigned-clock-rates = <100000000>;
+         #pwm-cells = <2>;
+     };
++
++  - |
++    #include <dt-bindings/clock/qcom,gcc-ipq8074.h>
++
++    pwm@7700020 {
++        compatible = "qcom,ipq8074-pwm";
++        reg = <0x07700020 0x10>;
++        clocks = <&gcc GCC_ADSS_PWM_CLK>;
++        assigned-clocks = <&gcc GCC_ADSS_PWM_CLK>;
++        assigned-clock-rates = <200000000>;
++        #pwm-cells = <2>;
++    };
diff --git a/target/linux/qualcommax/patches-6.12/0308-pwm-ipq-add-support-for-the-IPQ8074-v1-PWM-block.patch b/target/linux/qualcommax/patches-6.12/0308-pwm-ipq-add-support-for-the-IPQ8074-v1-PWM-block.patch
new file mode 100755
index 0000000000..736787d9cc
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0308-pwm-ipq-add-support-for-the-IPQ8074-v1-PWM-block.patch
@@ -0,0 +1,265 @@
+From: Andrey <ax9000@users.noreply.invalid>
+Subject: [PATCH] pwm: ipq: add support for the IPQ8074 (v1) PWM block
+
+The IPQ8074 PWM is the older block that Qualcomm's downstream driver
+(pwm-ipq4019.c in QSDK linux-msm 4.4, pwm-ipq.c in QSDK linux-ipq-5.4)
+drives with its "ops_v1": one 32-bit control register per channel at
+ADSS + 0x20 + 4 * n with
+
+  bit 31     ENABLE
+  bit 30     UPDATE (latch new values, cleared by hardware)
+  bits 29:22 PRE_DIV  (8 bits)
+  bits 20:10 HI_DUR   (11 bits)
+  bits 9:0   PWM_DIV  (10 bits)
+
+  period = (PRE_DIV + 1) * (PWM_DIV + 1) / clk
+  duty   = HI_DUR / (PWM_DIV + 1)
+
+Add it as a variant of pwm-ipq selected by "qcom,ipq8074-pwm". The
+divider search is shared with the v2 code, bounded by the v1 field
+widths. Programming follows the downstream sequence: write the fields
+with ENABLE clear, then set ENABLE | UPDATE. The idle level of a channel
+with ENABLE cleared is undocumented, so a disabled state is programmed
+as 0% duty cycle instead.
+
+Signed-off-by: Andrey <ax9000@users.noreply.invalid>
+---
+--- a/drivers/pwm/pwm-ipq.c
++++ b/drivers/pwm/pwm-ipq.c
+@@ -41,9 +41,30 @@
+ #define IPQ_PWM_REG1_UPDATE		BIT(30)
+ #define IPQ_PWM_REG1_ENABLE		BIT(31)
+ 
++/*
++ * Older (v1) block, e.g. IPQ8074, where the PWM lives in the ADSS (audio
++ * subsystem) block: one 32-bit control register per PWM (ADSS_GLB_PWMn_CTRL,
++ * ADSS offset 0x20 + 4 * #i). The node's reg points at PWM #0's register.
++ * Field layout and programming sequence follow the v1 ops of Qualcomm's
++ * downstream pwm-ipq4019.c/pwm-ipq.c.
++ */
++#define IPQ_PWM_V1_CTRL_PWM_DIV		GENMASK(9, 0)
++#define IPQ_PWM_V1_CTRL_HI_DURATION	GENMASK(20, 10)
++#define IPQ_PWM_V1_CTRL_PRE_DIV		GENMASK(29, 22)
++#define IPQ_PWM_V1_CTRL_UPDATE		BIT(30)
++#define IPQ_PWM_V1_CTRL_ENABLE		BIT(31)
++
++struct ipq_pwm_data {
++	bool v1;
++	u32 max_pre_div;
++	u32 max_pwm_div;
++	u32 max_hi_dur;
++};
++
+ struct ipq_pwm_chip {
+ 	struct clk *clk;
+ 	void __iomem *mem;
++	const struct ipq_pwm_data *data;
+ };
+ 
+ static struct ipq_pwm_chip *ipq_pwm_from_chip(struct pwm_chip *chip)
+@@ -95,13 +116,48 @@
+ 	ipq_pwm_reg_write(pwm, IPQ_PWM_REG1, val);
+ }
+ 
++static void ipq_pwm_v1_config(struct pwm_device *pwm, unsigned int pre_div,
++			      unsigned int pwm_div, u64 period_ns, u64 duty_ns,
++			      bool enable)
++{
++	struct ipq_pwm_chip *ipq_chip = ipq_pwm_from_chip(pwm->chip);
++	void __iomem *reg = ipq_chip->mem + 4 * pwm->hwpwm;
++	u64 hi_dur = 0;
++	u32 val;
++
++	/*
++	 * high duration = pwm duty * (pwm div + 1)
++	 * pwm duty = duty_ns / period_ns
++	 *
++	 * The output level of a v1 channel with ENABLE cleared is not
++	 * documented, so a disabled state is programmed as 0% duty cycle
++	 * (hi_dur = 0) with the channel kept running.
++	 */
++	if (enable)
++		hi_dur = min_t(u64, div64_u64((u64)(pwm_div + 1) * duty_ns,
++					      period_ns), pwm_div + 1);
++
++	val = FIELD_PREP(IPQ_PWM_V1_CTRL_PRE_DIV, pre_div) |
++	      FIELD_PREP(IPQ_PWM_V1_CTRL_HI_DURATION, hi_dur) |
++	      FIELD_PREP(IPQ_PWM_V1_CTRL_PWM_DIV, pwm_div);
++
++	/*
++	 * Same sequence as the downstream v1 driver: write the new dividers
++	 * and high duration with ENABLE clear, then set ENABLE and UPDATE.
++	 * UPDATE latches the new values and is cleared by hardware.
++	 */
++	writel(val, reg);
++	writel(val | IPQ_PWM_V1_CTRL_ENABLE | IPQ_PWM_V1_CTRL_UPDATE, reg);
++}
++
+ static int ipq_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
+ 			 const struct pwm_state *state)
+ {
+ 	struct ipq_pwm_chip *ipq_chip = ipq_pwm_from_chip(chip);
++	const struct ipq_pwm_data *data = ipq_chip->data;
+ 	unsigned int pre_div, pwm_div, best_pre_div, best_pwm_div;
+ 	unsigned long rate = clk_get_rate(ipq_chip->clk);
+-	u64 period_ns, duty_ns, period_rate;
++	u64 period_ns, duty_ns, period_rate, max_period_ns;
+ 	u64 min_diff;
+ 
+ 	if (state->polarity != PWM_POLARITY_NORMAL)
+@@ -110,33 +166,39 @@
+ 	if (state->period < DIV64_U64_ROUND_UP(NSEC_PER_SEC, rate))
+ 		return -ERANGE;
+ 
+-	period_ns = min(state->period, IPQ_PWM_MAX_PERIOD_NS);
+-	duty_ns = min(state->duty_cycle, period_ns);
+-
+ 	/*
+ 	 * period_ns is 1G or less. As long as rate is less than 16 GHz,
+ 	 * period_rate does not overflow. Make that explicit.
+ 	 */
+ 	if ((unsigned long long)rate > 16ULL * GIGA)
+ 		return -EINVAL;
++
++	/* Longest period the dividers can produce (about 1.3 ms for v1) */
++	max_period_ns = div64_u64((u64)(data->max_pre_div + 1) *
++				  (data->max_pwm_div + 1) * NSEC_PER_SEC, rate);
++	max_period_ns = min(max_period_ns, IPQ_PWM_MAX_PERIOD_NS);
++
++	period_ns = min(state->period, max_period_ns);
++	duty_ns = min(state->duty_cycle, period_ns);
++
+ 	period_rate = period_ns * rate;
+-	best_pre_div = IPQ_PWM_MAX_DIV;
+-	best_pwm_div = IPQ_PWM_MAX_DIV;
++	best_pre_div = data->max_pre_div;
++	best_pwm_div = data->max_pwm_div;
+ 	/*
+ 	 * We don't need to consider pre_div values smaller than
+ 	 *
+ 	 *                              period_rate
+ 	 *  pre_div_min := ------------------------------------
+-	 *                 NSEC_PER_SEC * (IPQ_PWM_MAX_DIV + 1)
++	 *                 NSEC_PER_SEC * (max_pwm_div + 1)
+ 	 *
+ 	 * because pre_div = pre_div_min results in a better
+ 	 * approximation.
+ 	 */
+ 	pre_div = div64_u64(period_rate,
+-			    (u64)NSEC_PER_SEC * (IPQ_PWM_MAX_DIV + 1));
++			    (u64)NSEC_PER_SEC * (data->max_pwm_div + 1));
+ 	min_diff = period_rate;
+ 
+-	for (; pre_div <= IPQ_PWM_MAX_DIV; pre_div++) {
++	for (; pre_div <= data->max_pre_div; pre_div++) {
+ 		u64 remainder;
+ 
+ 		pwm_div = div64_u64_rem(period_rate,
+@@ -157,7 +219,8 @@
+ 		 * Make sure we can do 100% duty cycle where
+ 		 * hi_dur == pwm_div + 1
+ 		 */
+-		if (pwm_div > IPQ_PWM_MAX_DIV - 1)
++		if (pwm_div > data->max_pwm_div ||
++		    pwm_div > data->max_hi_dur - 1)
+ 			continue;
+ 
+ 		if (remainder < min_diff) {
+@@ -171,8 +234,40 @@
+ 	}
+ 
+ 	/* config divider values for the closest possible frequency */
+-	config_div_and_duty(pwm, best_pre_div, best_pwm_div,
+-			    rate, duty_ns, state->enabled);
++	if (data->v1)
++		ipq_pwm_v1_config(pwm, best_pre_div, best_pwm_div, period_ns,
++				  duty_ns, state->enabled);
++	else
++		config_div_and_duty(pwm, best_pre_div, best_pwm_div,
++				    rate, duty_ns, state->enabled);
++
++	return 0;
++}
++
++static int ipq_pwm_v1_get_state(struct pwm_chip *chip, struct pwm_device *pwm,
++				struct pwm_state *state)
++{
++	struct ipq_pwm_chip *ipq_chip = ipq_pwm_from_chip(chip);
++	unsigned long rate = clk_get_rate(ipq_chip->clk);
++	unsigned int pre_div, pwm_div, hi_dur;
++	u64 effective_div, hi_div;
++	u32 val;
++
++	val = readl(ipq_chip->mem + 4 * pwm->hwpwm);
++
++	pre_div = FIELD_GET(IPQ_PWM_V1_CTRL_PRE_DIV, val);
++	hi_dur = FIELD_GET(IPQ_PWM_V1_CTRL_HI_DURATION, val);
++	pwm_div = FIELD_GET(IPQ_PWM_V1_CTRL_PWM_DIV, val);
++
++	/* 0% duty is how a disabled state is programmed, see above */
++	state->polarity = PWM_POLARITY_NORMAL;
++	state->enabled = (val & IPQ_PWM_V1_CTRL_ENABLE) && hi_dur;
++
++	effective_div = (u64)(pre_div + 1) * (pwm_div + 1);
++	state->period = DIV64_U64_ROUND_UP(effective_div * NSEC_PER_SEC, rate);
++
++	hi_div = (u64)min(hi_dur, pwm_div + 1) * (pre_div + 1);
++	state->duty_cycle = DIV64_U64_ROUND_UP(hi_div * NSEC_PER_SEC, rate);
+ 
+ 	return 0;
+ }
+@@ -186,6 +281,9 @@
+ 	u64 effective_div, hi_div;
+ 	u32 reg0, reg1;
+ 
++	if (ipq_chip->data->v1)
++		return ipq_pwm_v1_get_state(chip, pwm, state);
++
+ 	reg0 = ipq_pwm_reg_read(pwm, IPQ_PWM_REG0);
+ 	reg1 = ipq_pwm_reg_read(pwm, IPQ_PWM_REG1);
+ 
+@@ -223,6 +321,10 @@
+ 		return PTR_ERR(chip);
+ 	pwm = ipq_pwm_from_chip(chip);
+ 
++	pwm->data = of_device_get_match_data(dev);
++	if (!pwm->data)
++		return -ENODEV;
++
+ 	pwm->mem = devm_platform_ioremap_resource(pdev, 0);
+ 	if (IS_ERR(pwm->mem))
+ 		return dev_err_probe(dev, PTR_ERR(pwm->mem),
+@@ -233,6 +335,9 @@
+ 		return dev_err_probe(dev, PTR_ERR(pwm->clk),
+ 				"failed to get clock");
+ 
++	if (!clk_get_rate(pwm->clk))
++		return dev_err_probe(dev, -EINVAL, "clock rate is 0\n");
++
+ 	chip->ops = &ipq_pwm_ops;
+ 
+ 	ret = devm_pwmchip_add(dev, chip);
+@@ -242,8 +347,22 @@
+ 	return ret;
+ }
+ 
++static const struct ipq_pwm_data ipq6018_pwm_data = {
++	.max_pre_div = IPQ_PWM_MAX_DIV,
++	.max_pwm_div = IPQ_PWM_MAX_DIV,
++	.max_hi_dur = IPQ_PWM_MAX_DIV,
++};
++
++static const struct ipq_pwm_data ipq8074_pwm_data = {
++	.v1 = true,
++	.max_pre_div = 0xff,		/* IPQ_PWM_V1_CTRL_PRE_DIV */
++	.max_pwm_div = 0x3ff,		/* IPQ_PWM_V1_CTRL_PWM_DIV */
++	.max_hi_dur = 0x7ff,		/* IPQ_PWM_V1_CTRL_HI_DURATION */
++};
++
+ static const struct of_device_id pwm_ipq_dt_match[] = {
+-	{ .compatible = "qcom,ipq6018-pwm", },
++	{ .compatible = "qcom,ipq6018-pwm", .data = &ipq6018_pwm_data },
++	{ .compatible = "qcom,ipq8074-pwm", .data = &ipq8074_pwm_data },
+ 	{}
+ };
+ MODULE_DEVICE_TABLE(of, pwm_ipq_dt_match);
diff --git a/target/linux/qualcommax/patches-6.12/0309-arm64-dts-qcom-ipq8074-add-PWM-node.patch b/target/linux/qualcommax/patches-6.12/0309-arm64-dts-qcom-ipq8074-add-PWM-node.patch
new file mode 100755
index 0000000000..a1a63a0549
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.12/0309-arm64-dts-qcom-ipq8074-add-PWM-node.patch
@@ -0,0 +1,31 @@
+From: Andrey <ax9000@users.noreply.invalid>
+Subject: [PATCH] arm64: dts: qcom: ipq8074: add PWM node
+
+Add the v1 PWM block (four channels). Its control registers are
+ADSS_GLB_PWM0..3_CTRL at 0x07700020..0x0770002c inside the ADSS block
+(0x07700000); only those 16 bytes are claimed so the rest of ADSS stays
+available to a future audio driver. The clock runs at 200 MHz like the
+Qualcomm SDK, which gives a 1.31 ms maximum period and, for a 1 ms
+period, 1000 duty steps.
+
+Signed-off-by: Andrey <ax9000@users.noreply.invalid>
+---
+--- a/arch/arm64/boot/dts/qcom/ipq8074.dtsi
++++ b/arch/arm64/boot/dts/qcom/ipq8074.dtsi
+@@ -629,6 +629,16 @@
+ 			#interrupt-cells = <4>;
+ 		};
+ 
++		pwm: pwm@7700020 {
++			compatible = "qcom,ipq8074-pwm";
++			reg = <0x07700020 0x10>;
++			clocks = <&gcc GCC_ADSS_PWM_CLK>;
++			assigned-clocks = <&gcc GCC_ADSS_PWM_CLK>;
++			assigned-clock-rates = <200000000>;
++			#pwm-cells = <2>;
++			status = "disabled";
++		};
++
+ 		sdhc_1: mmc@7824900 {
+ 			compatible = "qcom,ipq8074-sdhci", "qcom,sdhci-msm-v4";
+ 			reg = <0x7824900 0x500>, <0x7824000 0x800>;
-- 
