#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode -L '/usr/share/ax9000/*.uc' /usr/sbin/ax9000-ledd
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ax9000
}

reload_service() {
	restart
}
