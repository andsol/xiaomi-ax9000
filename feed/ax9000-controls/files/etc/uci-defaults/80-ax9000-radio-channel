#!/bin/sh
# The QCN9074 radio (PCIe 20000000.pcie) only works below channel 100 with the
# AX9000 BDF. An existing wireless config kept across a sysupgrade may still pin
# it to a DFS/upper channel, which leaves the radio down. Reset only that radio
# to 'auto'. Idempotent; never touches any other radio.

changed=0
for dev in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	case "$(uci -q get wireless.$dev.path)" in
	*20000000.pcie*) ;;
	*) continue ;;
	esac
	ch="$(uci -q get wireless.$dev.channel)"
	case "$ch" in
	''|*[!0-9]*) continue ;;
	esac
	if [ "$ch" -ge 100 ]; then
		uci -q set wireless.$dev.channel='auto'
		logger -t ax9000 "radio $dev (QCN9074): channel $ch is unsupported, reset to auto"
		changed=1
	fi
done

[ "$changed" = 1 ] && uci -q commit wireless
exit 0
