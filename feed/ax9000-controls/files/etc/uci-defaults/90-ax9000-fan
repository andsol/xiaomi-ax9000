#!/bin/sh
# Fan configuration in /etc/config/ax9000: a 'day' and a 'night' setting
# (each a 4-point curve or a fixed speed) plus the night hours.
#
# Creates it on a fresh install and converts the old schema once (fan.mode with
# silent/balanced/aggressive/custom/manual and fan_schedule windows). An old
# "manual" mode becomes a fixed day speed; the old curves and windows are
# dropped because the new curve stops the fan below its first point.
# Existing new-style settings are never touched.

profile() {
	# name mode fixed_duty p1 p2 p3 p4
	uci -q get "ax9000.$1" >/dev/null && return
	uci -q batch <<EOF
set ax9000.$1=fan_profile
set ax9000.$1.mode='$2'
set ax9000.$1.fixed_duty='$3'
set ax9000.$1.hysteresis='3'
add_list ax9000.$1.point='$4'
add_list ax9000.$1.point='$5'
add_list ax9000.$1.point='$6'
add_list ax9000.$1.point='$7'
EOF
}

if ! uci -q get ax9000.fan >/dev/null; then
	uci -q batch <<'EOF'
set ax9000.fan=fan
set ax9000.fan.interval='5'
add_list ax9000.fan.sensor='cpu0-thermal'
add_list ax9000.fan.sensor='cpu1-thermal'
add_list ax9000.fan.sensor='cpu2-thermal'
add_list ax9000.fan.sensor='cpu3-thermal'
add_list ax9000.fan.sensor='nss-top-thermal'
add_list ax9000.fan.sensor='nss0-thermal'
add_list ax9000.fan.sensor='nss1-thermal'
add_list ax9000.fan.sensor='wcss-phya0-thermal'
add_list ax9000.fan.sensor='wcss-phya1-thermal'
add_list ax9000.fan.sensor='wcss-phyb0-thermal'
add_list ax9000.fan.sensor='wcss-phyb1-thermal'
add_list ax9000.fan.sensor='ath11k_hwmon'
add_list ax9000.fan.sensor='ath10k_hwmon'
EOF
fi

old_mode="$(uci -q get ax9000.fan.mode)"
if [ -n "$old_mode" ]; then
	manual="$(uci -q get ax9000.fan.manual_duty)"
	for s in silent balanced aggressive custom; do
		uci -q delete "ax9000.$s"
	done
	while uci -q delete ax9000.@fan_schedule[0]; do :; done
	uci -q delete ax9000.fan.mode
	uci -q delete ax9000.fan.manual_duty
	uci -q delete ax9000.fan.schedule_enabled
	if [ "$old_mode" = manual ]; then
		profile day fixed "${manual:-40}" 60:25 68:40 76:65 84:100
	fi
fi

profile day curve 40 60:25 68:40 76:65 84:100
profile night curve 20 65:20 72:30 80:55 86:100

uci -q get ax9000.fan.night_enabled >/dev/null || uci -q set ax9000.fan.night_enabled='0'
uci -q get ax9000.fan.night_start >/dev/null || uci -q set ax9000.fan.night_start='23:00'
uci -q get ax9000.fan.night_end >/dev/null || uci -q set ax9000.fan.night_end='07:00'

uci commit ax9000
exit 0
